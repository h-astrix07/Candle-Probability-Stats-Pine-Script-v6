// ============================================================
// INDIKATOR: Candle Probability Stats — Enhanced v4.0
// Pine Script v6
// Fitur: Statistik candle, volume trend, garis tren, prediksi
// ============================================================

//@version=6
indicator(title = "Candle Probability Stats", shorttitle = "CPS", overlay = true)

// ============================================================
// BAGIAN 1: INPUT — semua bisa diubah dari Settings
// ============================================================

// Jumlah candle yang dihitung untuk statistik
i_len = input.int(100, "Periode Statistik", minval = 10, maxval = 500)

// Jumlah candle untuk menghitung garis tren (linear regression)
i_trendLen = input.int(20, "Periode Tren", minval = 5, maxval = 100)

// Jumlah candle untuk membandingkan volume (recent vs lama)
i_volLen = input.int(10, "Periode Volume", minval = 5, maxval = 50)

// Posisi tabel — bisa dipindah via dropdown
i_pos = input.string("Top Right", "Posisi Tabel",
    options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

// Toggle: tampilkan garis tren di chart atau tidak
i_showTrend = input.bool(true, "Tampilkan Garis Tren")

// Toggle: tampilkan garis prediksi ke depan
i_showPred = input.bool(true, "Tampilkan Prediksi")

// Berapa bar ke depan untuk proyeksi prediksi
i_predBars = input.int(5, "Bar Prediksi ke Depan", minval = 1, maxval = 20)

// ============================================================
// BAGIAN 2: HITUNG STATISTIK CANDLE (loop mundur)
// ============================================================

var float bullCount = 0.0
var float bearCount = 0.0
var float dojiCount = 0.0

bullCount := 0.0
bearCount := 0.0
dojiCount := 0.0

for i = 0 to i_len - 1
    pC = close[i]
    pO = open[i]
    pH = high[i]
    pL = low[i]
    thresh = (pH - pL) * 0.10           // body < 10% range = doji

    if math.abs(pC - pO) <= thresh
        dojiCount += 1
    else if pC > pO
        bullCount += 1
    else
        bearCount += 1

total = bullCount + bearCount + dojiCount
bullPct = total > 0 ? bullCount / total * 100 : 0.0
bearPct = total > 0 ? bearCount / total * 100 : 0.0
dojiPct = total > 0 ? dojiCount / total * 100 : 0.0

// ============================================================
// BAGIAN 3: ANALISIS VOLUME
// Bandingkan rata-rata volume recent vs periode lebih lama
// ============================================================

// Rata-rata volume i_volLen bar terakhir (recent)
volRecent = ta.sma(volume, i_volLen)

// Rata-rata volume i_volLen*3 bar terakhir (baseline lebih lama)
volBase = ta.sma(volume, i_volLen * 3)

// Perubahan volume dalam persen
volChg = volBase > 0 ? (volRecent - volBase) / volBase * 100 : 0.0

// Label volume — naik atau turun
volLabel = volChg >= 0 ? "▲ +" + str.tostring(volChg, "#.1") + "%" : "▼ " + str.tostring(volChg, "#.1") + "%"
volColor = volChg >= 0 ? color.new(#00c896, 0) : color.new(#ff4d4d, 0)

// ============================================================
// BAGIAN 4: GARIS TREN — Linear Regression
// Menghitung slope harga close i_trendLen bar terakhir
// ============================================================

// Nilai linear regression di bar saat ini (endpoint)
lrCurr = ta.linreg(close, i_trendLen, 0)

// Nilai linear regression 1 bar sebelumnya
lrPrev = ta.linreg(close, i_trendLen, 1)

// Slope = selisih endpoint regression (positif = tren naik)
lrSlope = lrCurr - lrPrev

// Apakah tren naik atau turun?
isTrendUp = lrSlope > 0

// Warna garis tren: hijau jika naik, merah jika turun
trendColor = isTrendUp ? color.new(#00c896, 20) : color.new(#ff4d4d, 20)

// Gambar garis tren linear regression di chart
trendLine = i_showTrend ? ta.linreg(close, i_trendLen, 0) : na
plot(trendLine,
    title     = "Garis Tren",
    color     = trendColor,
    linewidth = 2,
    style     = plot.style_line)

// ============================================================
// BAGIAN 5: PROYEKSI PREDIKSI KE DEPAN
// Perpanjang garis tren ke kanan sebagai estimasi arah
// ============================================================

// Hitung posisi proyeksi berdasarkan slope & bar ke depan
// ta.linreg(src, len, offset) — offset negatif = bar ke depan
// Tapi offset harus >= 0 di Pine, jadi kita manual hitung

// Gunakan channel regression sebagai zona prediksi
// Upper & lower band dari regression (±1 std dev)
regUpper = ta.linreg(close, i_trendLen, 0) + ta.stdev(close, i_trendLen)
regLower = ta.linreg(close, i_trendLen, 0) - ta.stdev(close, i_trendLen)

// Plot channel atas (transparan) sebagai zona prediksi
plot(i_showPred ? regUpper : na,
    title     = "Zona Prediksi Atas",
    color     = color.new(#FFD060, 75),
    linewidth = 1,
    style     = plot.style_line)

// Plot channel bawah (transparan)
plot(i_showPred ? regLower : na,
    title     = "Zona Prediksi Bawah",
    color     = color.new(#FFD060, 75),
    linewidth = 1,
    style     = plot.style_line)

// Isi area antara upper & lower (zona prediksi berwarna)
bullFill = plot(i_showPred ? regUpper : na, display = display.none)
bearFill = plot(i_showPred ? regLower : na, display = display.none)
fill(bullFill, bearFill,
    color = isTrendUp ? color.new(#00c896, 90) : color.new(#ff4d4d, 90),
    title = "Zona Prediksi Fill")

// ============================================================
// BAGIAN 6: TENTUKAN BIAS & PREDIKSI ARAH
// ============================================================

// Bias statistik berdasarkan hitungan candle
biasStr   = bullPct > bearPct + 5 ? "▲ BULLISH" : bearPct > bullPct + 5 ? "▼ BEARISH" : "◆ NETRAL"
biasColor = bullPct > bearPct + 5 ? color.new(#00c896, 0) : bearPct > bullPct + 5 ? color.new(#ff4d4d, 0) : color.new(#8899bb, 0)

// Prediksi arah berdasarkan slope tren
predStr   = isTrendUp ? "▲ Naik" : "▼ Turun"
predColor = isTrendUp ? color.new(#00c896, 0) : color.new(#ff4d4d, 0)

// Kekuatan tren berdasarkan besarnya slope relatif terhadap harga
trendStrength = math.abs(lrSlope) / close * 1000      // dalam basis points
trendStr = trendStrength > 2 ? "Kuat" : trendStrength > 0.5 ? "Sedang" : "Lemah"

// ============================================================
// BAGIAN 7: BUAT DAN ISI TABEL — compact & clean
// ============================================================

tablePos = switch i_pos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

var table t = table.new(tablePos, 2, 13,
    border_width = 1,
    border_color = color.new(#2a2d3e, 0))

if barstate.islast

    // Warna palet compact
    bg0   = color.new(#1e2235, 0)    // header
    bg1   = color.new(#12141c, 40)   // baris gelap
    bg2   = color.new(#1a1d28, 40)   // baris medium
    bgBull= color.new(#0a2018, 0)    // latar bullish
    bgBear= color.new(#25090a, 0)    // latar bearish
    bgVol = color.new(#141828, 0)    // latar volume
    bgPred= color.new(#1a1830, 0)    // latar prediksi
    bgBias= bullPct > bearPct + 5 ? color.new(#0a2018, 0) : bearPct > bullPct + 5 ? color.new(#25090a, 0) : color.new(#1e2235, 0)

    tw  = color.white
    tmu = color.new(#7a8299, 0)
    tsi = color.new(#c0c8dc, 0)
    ty  = color.new(#FFD060, 0)

    // Baris 0: header
    table.cell(t, 0, 0, "▶ STATS", text_color = tw, bgcolor = bg0, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 0, syminfo.tickerid, text_color = ty, bgcolor = bg0, text_size = size.small, text_halign = text.align_right)

    // Baris 1: timeframe
    table.cell(t, 0, 1, "TF", text_color = tmu, bgcolor = bg1, text_size = size.tiny)
    table.cell(t, 1, 1, timeframe.period, text_color = tsi, bgcolor = bg1, text_size = size.tiny, text_halign = text.align_right)

    // Baris 2: periode
    table.cell(t, 0, 2, "Periode", text_color = tmu, bgcolor = bg2, text_size = size.tiny)
    table.cell(t, 1, 2, str.tostring(i_len) + " bar", text_color = tsi, bgcolor = bg2, text_size = size.tiny, text_halign = text.align_right)

    // Baris 3: separator
    table.cell(t, 0, 3, "", bgcolor = color.new(#0d0f1a, 0))
    table.cell(t, 1, 3, "", bgcolor = color.new(#0d0f1a, 0))

    // Baris 4: bullish
    table.cell(t, 0, 4, "▲ Bullish", text_color = color.new(#00c896, 0), bgcolor = bgBull, text_size = size.small)
    table.cell(t, 1, 4, str.tostring(int(bullCount)) + " (" + str.tostring(bullPct, "#.0") + "%)", text_color = color.new(#00c896, 0), bgcolor = bgBull, text_size = size.small, text_halign = text.align_right)

    // Baris 5: bearish
    table.cell(t, 0, 5, "▼ Bearish", text_color = color.new(#ff4d4d, 0), bgcolor = bgBear, text_size = size.small)
    table.cell(t, 1, 5, str.tostring(int(bearCount)) + " (" + str.tostring(bearPct, "#.0") + "%)", text_color = color.new(#ff4d4d, 0), bgcolor = bgBear, text_size = size.small, text_halign = text.align_right)

    // Baris 6: doji
    table.cell(t, 0, 6, "◆ Doji", text_color = color.new(#7a8aaa, 0), bgcolor = bg1, text_size = size.tiny)
    table.cell(t, 1, 6, str.tostring(int(dojiCount)) + " (" + str.tostring(dojiPct, "#.0") + "%)", text_color = color.new(#7a8aaa, 0), bgcolor = bg1, text_size = size.tiny, text_halign = text.align_right)

    // Baris 7: separator
    table.cell(t, 0, 7, "", bgcolor = color.new(#0d0f1a, 0))
    table.cell(t, 1, 7, "", bgcolor = color.new(#0d0f1a, 0))

    // Baris 8: volume change
    table.cell(t, 0, 8, "Volume", text_color = tmu, bgcolor = bgVol, text_size = size.tiny)
    table.cell(t, 1, 8, volLabel, text_color = volColor, bgcolor = bgVol, text_size = size.tiny, text_halign = text.align_right)

    // Baris 9: tren (slope)
    table.cell(t, 0, 9, "Tren", text_color = tmu, bgcolor = bgVol, text_size = size.tiny)
    table.cell(t, 1, 9, (isTrendUp ? "▲ Naik " : "▼ Turun ") + trendStr, text_color = predColor, bgcolor = bgVol, text_size = size.tiny, text_halign = text.align_right)

    // Baris 10: separator
    table.cell(t, 0, 10, "", bgcolor = color.new(#0d0f1a, 0))
    table.cell(t, 1, 10, "", bgcolor = color.new(#0d0f1a, 0))

    // Baris 11: prediksi arah
    table.cell(t, 0, 11, "Prediksi", text_color = tmu, bgcolor = bgPred, text_size = size.tiny)
    table.cell(t, 1, 11, predStr, text_color = predColor, bgcolor = bgPred, text_size = size.small, text_halign = text.align_right)

    // Baris 12: bias kesimpulan
    table.cell(t, 0, 12, "Bias", text_color = tw, bgcolor = bgBias, text_size = size.small)
    table.cell(t, 1, 12, biasStr, text_color = biasColor, bgcolor = bgBias, text_size = size.small, text_halign = text.align_right)

// ============================================================
// BAGIAN 8: BACKGROUND HIGHLIGHT BAR TERAKHIR
// ============================================================

bgcolor(
    barstate.islast and bullPct > bearPct + 5 ? color.new(color.teal, 92) :
    barstate.islast and bearPct > bullPct + 5 ? color.new(color.red,  92) : na,
    title = "Bias Bar Highlight")
